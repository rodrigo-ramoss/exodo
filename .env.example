# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Chave da API do Gemini (Google AI Studio)
GEMINI_API_KEY="sua_chave_gemini_aqui"

# ─── URL do App ───────────────────────────────────────────────────────────────
# URL base do app — usada nos links de retorno do Stripe
# Em produção: https://exodo-app.vercel.app (ou seu domínio customizado)
APP_URL="https://exodo-app.vercel.app"
NEXT_PUBLIC_SITE_URL="https://exodo-app.vercel.app"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Chave secreta do Stripe (Dashboard → Developers → API Keys)
STRIPE_SECRET_KEY="sk_live_..."

# Price ID do plano mensal (Dashboard → Products → copie o Price ID)
# O Price ID atual do Voz do Deserto: price_1THuvNPDxOsGzCZMoDUxsNLA
STRIPE_MONTHLY_PRICE_ID="price_..."

# Webhook secret — crie um novo webhook no Stripe apontando para:
# https://exodo-app.vercel.app/api/webhook
# (Dashboard → Developers → Webhooks → Add endpoint)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Brevo (e-mail marketing, opcional) ──────────────────────────────────────
# Chave da API do Brevo para adicionar assinantes à lista de e-mail
BREVO_API_KEY="sua_chave_brevo_aqui"

# ─── Autenticação (login por código) ─────────────────────────────────────────
# Controle da barreira de login. Use "true" quando o login estiver configurado.
VITE_AUTH_GATE_ENABLED="false"

# Segredo usado para assinar sessão do usuário (obrigatório)
AUTH_SESSION_SECRET="troque_por_um_valor_longo_e_aleatorio"

# Segredo específico para desafio OTP (opcional; se vazio usa AUTH_SESSION_SECRET)
AUTH_CHALLENGE_SECRET="troque_por_um_valor_longo_e_aleatorio"

# Remetente dos e-mails de login (deve existir na Brevo)
AUTH_FROM_EMAIL="nao-responda@seudominio.com"
AUTH_FROM_NAME="Exodo"

# ─── Redis para rate limit/auditoria (recomendado em produção) ──────────────
# Upstash Redis REST (Database -> REST API)
UPSTASH_REDIS_REST_URL="https://<seu-endpoint>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu_token_rest"

# Auditoria de login (opcional)
AUTH_AUDIT_REDIS_KEY="auth:audit:events"
AUTH_AUDIT_MAX_ITEMS="3000"
AUTH_AUDIT_TTL_SECONDS="2592000"
